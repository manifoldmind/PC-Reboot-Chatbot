### 📄 `core/reboot.py` (реальный бэкенд)

```python
import subprocess, time, logging

log = logging.getLogger("reboot")
REBOOT_CMD_WIN = "shutdown /r /t 5 /f"
OP_TIMEOUT = 60                      # ТЗ: таймаут операции 60 с
DENIED_MARKS = ("access is denied", "отказано в доступе", "unauthorized", "403")

def _run_ps(hostname: str, script: str, timeout: int = OP_TIMEOUT):
    cmd = ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command",
           f'Invoke-Command -ComputerName "{hostname}" -ScriptBlock {{ {script} }}']
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)

def reboot_pc(hostname: str) -> dict:
    """{hostname, ok, stage, detail, duration} — один ПК, любые исключения гасим внутрь."""
    t0 = time.time()
    def out(ok, stage, detail):
        return {"hostname": hostname, "ok": ok, "stage": stage,
                "detail": detail[:200], "duration": round(time.time() - t0, 1)}
    try:
        r = _run_ps(hostname, REBOOT_CMD_WIN)
        if r.returncode == 0:
            log.info("command accepted", extra={"hostname": hostname})
            return out(True, "command_accepted", "shutdown /r /t 5 /f принят")
        detail = (r.stderr or r.stdout).strip()
        stage = "access_denied" if any(m in detail.lower() for m in DENIED_MARKS) else "command_rejected"
        return out(False, stage, detail)
    except subprocess.TimeoutExpired:
        return out(False, "timeout", f"нет ответа >{OP_TIMEOUT}с")
    except Exception as e:                       # сеть, DNS, WinRM не включён...
        return out(False, "unreachable", str(e))

def ping_check(hostname: str, wait_sec: int = 30, probes: int = 3) -> dict:
    """ТЗ 3.1 шаг 7: ждём 30с, ПК должен ПРОПАСТЬ из ping (ушёл в ребут)."""
    time.sleep(wait_sec)
    lost = 0
    for _ in range(probes):
        p = subprocess.run(["ping", "-n", "1", "-w", "1000", hostname], capture_output=True)
        lost += p.returncode != 0
    return {"went_down": lost == probes, "detail": f"ping lost {lost}/{probes}"}
```

### 📄 `cli.py` (консольный пульт с параллельностью)

```python
import argparse, concurrent.futures as cf, json, os, sys
from datetime import datetime
from core import reboot

def parse_hosts(args) -> list:
    raw = list(args.hosts)
    if args.file:
        with open(args.file, encoding="utf-8") as f:
            raw += [ln.strip() for ln in f if ln.strip()]
    hosts, seen = [], set()
    for item in raw:
        for h in item.replace(";", ",").split(","):
            h = h.strip()
            if h and h.lower() not in seen:
                seen.add(h.lower()); hosts.append(h)
    return hosts

def run_one(hostname: str, check: bool) -> dict:
    res = reboot.reboot_pc(hostname)
    if check and res["ok"]:
        res["ping"] = reboot.ping_check(hostname)
    return res

def main():
    ap = argparse.ArgumentParser(description="PCReboot: консольный харнес")
    ap.add_argument("hosts", nargs="*", help="hostnames ПК")
    ap.add_argument("--file", help="файл со списком (по одному в строке)")
    ap.add_argument("--dry-run", action="store_true", help="план без отправки команд")
    ap.add_argument("--check", action="store_true", help="ping-проверка через 30с")
    ap.add_argument("--workers", type=int, default=10, help="лимит параллельности")
    ap.add_argument("--yes", action="store_true", help="без подтверждения")
    args = ap.parse_args()

    hosts = parse_hosts(args)
    if not hosts:
        print("Передай список ПК: cli.py WS-1 WS-2  или  --file pcs.txt"); sys.exit(1)

    print(f"Цели ({len(hosts)}): {', '.join(hosts)}")
    if args.dry_run:
        print("[DRY-RUN] Команды НЕ отправляются."); sys.exit(0)
    if not args.yes and input(f"Перезагрузить {len(hosts)} ПК? [y/N]: ").strip().lower() not in ("y", "yes", "д", "да"):
        print("Отменено."); sys.exit(0)

    os.makedirs("logs", exist_ok=True)
    log_path = f"logs/reboot_{datetime.now():%Y%m%d_%H%M%S}.jsonl"
    results = []
    # ⚙ Параллельность: каждый ПК — свой поток; исключение в одном не трогает других
    with cf.ThreadPoolExecutor(max_workers=min(args.workers, len(hosts))) as ex:
        futs = {ex.submit(run_one, h, args.check): h for h in hosts}
        with open(log_path, "a", encoding="utf-8") as lf:   # пишет только главный поток
            for fut in cf.as_completed(futs):
                r = fut.result()
                results.append(r)
                lf.write(json.dumps(r, ensure_ascii=False) + "\n")
                mark = "OK  " if r["ok"] else "FAIL"
                print(f"[{mark}] {r['hostname']:<16} {r['stage']:<16} {r['duration']:>5.1}s")

    ok_n = sum(r["ok"] for r in results)
    print("\n==== ОТБИВКА ====")
    for r in sorted(results, key=lambda x: x["hostname"]):
        ping = r.get("ping", {}).get("detail", "")
        print(f"{'OK  ' if r['ok'] else 'FAIL'} {r['hostname']:<16} {r['stage']:<16} "
              f"{r['duration']:>5.1}s  {r['detail'][:60]}  {ping}")
    print(f"Всего: {len(results)} | OK: {ok_n} | FAIL: {len(results) - ok_n} | лог: {log_path}")
    sys.exit(0 if ok_n == len(results) else 2)

if __name__ == "__main__":
    main()
```

